# Optional: API Keys for market data
# ALPHA_VANTAGE_KEY=your_key_here
# FINNHUB_KEY=your_key_here

# IBKR Flex Web Service (reconciliación de operaciones — fase K7)
IBKR_FLEX_TOKEN=
